/var/log/mesh-node/events.jsonl {
    daily
    rotate 14
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    # No su directive. systemd's StandardOutput=append creates the file as
    # root whatever User= says, so rotating as meshnode cannot truncate it —
    # logrotate then skips the file silently and it grows without limit.
}
