[Unit]
Description=Machine Elves connection probe (one measurement)
Documentation=file:/usr/local/share/mesh-probe/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=meshprobe
Group=meshprobe
EnvironmentFile=/etc/mesh-probe/config
# A fixed local port on purpose. Bound to zero the system picks a new one each
# run, the external address changes every time, and the log cannot tell an
# address that genuinely moved from one that was never going to be the same
# twice. Fixed, every reading is comparable to the last, and the log answers
# on its own whether a remembered address would still work.
ExecStart=/usr/local/bin/mesh-probe --json --label ${LABEL} --port ${PORT}

# One JSON record appended per run. Line-oriented so a partial write from a
# power cut costs one measurement rather than the file.
StandardOutput=append:/var/log/mesh-probe/results.jsonl
StandardError=journal

# The probe needs UDP out and nothing else whatsoever.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/mesh-probe
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
